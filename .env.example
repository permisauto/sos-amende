# ===== SOS Amende — variables d'environnement =====
# Copier ce fichier en `.env` et renseigner les valeurs.
# Ne jamais committer le `.env` (gitignored).

# --- Base de données (obligatoire) ---
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
# PROD (Vercel) : connexion directe Supabase (port 5432, hors pooler transactionnel
# 6543) utilisée par `prisma migrate deploy` — les migrations ont besoin de
# verrous de session que le pooler transactionnel ne supporte pas. En dev, absent.
DIRECT_URL=""

# --- Auth (NextAuth v5, magic-link) ---
# Requis même en dev pour les magic-links. Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# Requis en PROD : clé Resend qui envoie les liens de connexion.
# Sans cette clé, le lien dev est écrit dans node_modules/.cache/dev-magic-link-<email>.txt
AUTH_RESEND_KEY=""
# Expéditeur des e-mails Resend (domaine vérifié en prod — pas onboarding@resend.dev).
EMAIL_FROM="SOS Amende <no-reply@recours-permis-pv.com>"
# URL canonique (NextAuth v5). Facultatif en dev, recommandé en prod.
AUTH_URL=""
# Email du super admin (ADMIN) : à sa première connexion via magic-link, ce
# compte est automatiquement élevé au rôle ADMIN. Facultatif.
SUPER_ADMIN_EMAIL=""

# --- URL publique de l'app (requis en PROD ; sert aussi au mock ANTAI) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OCR (relecture humaine obligatoire) ---
# mock (dev/E2E) | google-vision | mistral-ocr (hébergement UE, RGPD) |
# gemini-flash (Google AI, niveau gratuit, GEMINI_API_KEY) |
# tesseract (local, gratuit, RGPD) | (absent = aucun préremplissage)
OCR_PROVIDER="mock"
GOOGLE_VISION_KEY=""
MISTRAL_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- Stockage des pièces (PV, signatures, PDF) ---
# local (dev/E2E, écrit dans public/uploads) | s3 (PROD, bucket UE)
# GARDE-FOU : en production réelle (NODE_ENV=production sans AUTH_DEV_FILE=1),
# le mode "local" est REJETÉ par le code (accès public aux pièces RGPD).
# Configurer STORAGE_DRIVER=s3 en prod, sinon tout accès stockage échoue (500).
STORAGE_DRIVER="local"
# Requis uniquement en mode s3 (S3-compatible UE : Scaleway, OVHcloud…)
STORAGE_BUCKET=""
STORAGE_REGION="eu-west-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- ANTAI (mock local uniquement — jamais le portail réel) ---
ANTAI_MOCK_TOKEN="dev-antai-mock"
# Activer le RPA Playwright réel (ANTAI_REAL=1) — nécessite ANTAI_URL/LOGIN/PASSWORD
ANTAI_REAL="0"
ANTAI_URL=""
ANTAI_LOGIN=""
ANTAI_PASSWORD=""

# --- Cron / rappels ---
# Optionnel : protège /api/cron/rappels (J10/J3/J0)
CRON_SECRET=""

# --- Virement bancaire (RIB à afficher au paiement) ---
# RIB définitif à renseigner quand vous l'aurez (sinon placeholder affiché)
RIB_IBAN="BE06 9058 9752 3122"
RIB_BIC="TRWIBEB1XXX"
RIB_TITULAIRE="DIXIT LLC"
RIB_BANQUE="Wise"
NEXT_PUBLIC_RIB_IBAN="BE06 9058 9752 3122"
NEXT_PUBLIC_RIB_BIC="TRWIBEB1XXX"
NEXT_PUBLIC_RIB_TITULAIRE="DIXIT LLC"