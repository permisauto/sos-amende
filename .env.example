# ===== SOS Amende — variables d'environnement =====
# Copier ce fichier en `.env` et renseigner les valeurs.
# Ne jamais committer le `.env` (gitignored).

# --- Base de données (obligatoire) ---
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# --- Auth (NextAuth v5, magic-link) ---
# Requis même en dev pour les magic-links. Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# Requis en PROD : clé Resend qui envoie les liens de connexion.
# Sans cette clé, le lien dev est écrit dans node_modules/.cache/dev-magic-link-<email>.txt
AUTH_RESEND_KEY=""
# Expéditeur des e-mails Resend (domaine vérifié en prod — pas onboarding@resend.dev).
EMAIL_FROM="SOS Amende <no-reply@sos-amende.fr>"
# URL canonique (NextAuth v5). Facultatif en dev, recommandé en prod.
AUTH_URL=""

# --- URL publique de l'app (requis en PROD ; sert aussi au mock ANTAI/Stripe) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (paiement à l'acte, inscription inversée) ---
# Requis en PROD pour le checkout et le webhook réels.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Prix : amende (39 €), suspension (59 €), abonnement mensuel (optionnel).
STRIPE_PRICE_AMENDE=""
STRIPE_PRICE_SUSPENSION=""
STRIPE_PRICE_MONTHLY=""
# Garde-fou dev/E2E : `1` active le portail de paiement local /mock-stripe.
# Ne jamais mettre `1` en production.
STRIPE_MOCK="1"

# --- OCR (relecture humaine obligatoire) ---
# mock (dev/E2E) | google-vision | mistral-ocr (hébergement UE, RGPD) |
# tesseract (local, gratuit, RGPD) | (absent = aucun préremplissage)
OCR_PROVIDER="mock"
GOOGLE_VISION_KEY=""
MISTRAL_API_KEY=""

# --- Stockage des pièces (PV, signatures, PDF) ---
# local (dev/E2E, écrit dans public/uploads) | s3 (PROD, bucket UE)
STORAGE_DRIVER="local"
# Requis uniquement en mode s3 (S3-compatible UE : Scaleway, OVHcloud…)
STORAGE_BUCKET=""
STORAGE_REGION="eu-west-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- ANTAI (mock local uniquement — jamais le portail réel) ---
ANTAI_MOCK_TOKEN="dev-antai-mock"

# --- Cron / rappels ---
# Optionnel : protège /api/cron/rappels (J10/J3/J0)
CRON_SECRET=""

# --- Virement bancaire (RIB à afficher au paiement) ---
# RIB définitif à renseigner quand vous l'aurez (sinon placeholder affiché)
RIB_IBAN="FR76 1234 5678 9012 3456 7890 123"
RIB_BIC="ABCDFRPPXXX"
RIB_TITULAIRE="SOS Amende"
RIB_BANQUE="Banque Exemple"
NEXT_PUBLIC_RIB_IBAN="FR76 1234 5678 9012 3456 7890 123"
NEXT_PUBLIC_RIB_BIC="ABCDFRPPXXX"
NEXT_PUBLIC_RIB_TITULAIRE="SOS Amende"