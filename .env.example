# ===== SOS Amende — variables d'environnement =====
# Copier ce fichier en `.env` et renseigner les valeurs.
# Ne jamais committer le `.env` (gitignored).

# --- Base de données (obligatoire) ---
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
# PROD (Vercel) : connexion directe Supabase (port 5432, hors pooler transactionnel
# 6543) utilisée par `prisma migrate deploy` — les migrations ont besoin de
# verrous de session que le pooler transactionnel ne supporte pas. En dev, absent.
DIRECT_URL=""

# --- Auth (NextAuth v5, magic-link) ---
# Requis même en dev pour les magic-links. Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# Requis en PROD : clé Resend qui envoie les liens de connexion.
# Sans cette clé, le lien dev est écrit dans node_modules/.cache/dev-magic-link-<email>.txt
AUTH_RESEND_KEY=""
# Expéditeur des e-mails Resend (domaine vérifié en prod — pas onboarding@resend.dev).
EMAIL_FROM="SOS Amende <no-reply@recours-permis-pv.com>"
# URL canonique (NextAuth v5). Facultatif en dev, recommandé en prod.
AUTH_URL=""
# Email du super admin (ADMIN) : à sa première connexion via magic-link, ce
# compte est automatiquement élevé au rôle ADMIN. Facultatif.
SUPER_ADMIN_EMAIL=""

# --- URL publique de l'app (requis en PROD ; sert aussi au mock ANTAI) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OCR (relecture humaine obligatoire) ---
# mock (dev/E2E) | google-vision | mistral-ocr (hébergement UE, RGPD) |
# gemini-flash (Google AI, niveau gratuit, GEMINI_API_KEY) |
# tesseract (local, gratuit, RGPD) | (absent = aucun préremplissage)
OCR_PROVIDER="mock"
# Watchdog OCR (ms) : au-delà, extrairePv rend null (dépôt jamais bloqué). Défaut 20000.
OCR_TIMEOUT_MS=""
# Délai par requête OCR (ms), AbortSignal.timeout → 504 retriable. Défaut 10000.
OCR_HTTP_TIMEOUT_MS=""
GOOGLE_VISION_KEY=""
MISTRAL_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- Vérification des failles (« Vérifier les failles », IA optionnelle) ---
# mock = simulation déterministe sans appel réseau (dev/E2E, suggestions
# tracées « Simulation (mock) » — jamais prises pour un avis réel) ;
# off = saisie par règles seules ; vide = Gemini si GEMINI_API_KEY présente,
# sinon indisponible (le juriste relance quand même par règles).
VERIF_IA_PROVIDER=""

# --- Stockage des pièces (PV, signatures, PDF) ---
# local (dev/E2E, écrit dans public/uploads) | s3 (PROD, bucket UE)
# GARDE-FOU : en production réelle (NODE_ENV=production sans le double-gate
# E2E AUTH_DEV_FILE=1 ET ANTAI_MOCK=1), le mode "local" est REJETÉ par le code
# (accès public aux pièces RGPD). Configurer STORAGE_DRIVER=s3 en prod, sinon
# tout accès stockage échoue (500).
STORAGE_DRIVER="local"
# Requis uniquement en mode s3 (S3-compatible UE : Scaleway, OVHcloud…)
STORAGE_BUCKET=""
STORAGE_REGION="eu-west-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- ANTAI (mock local uniquement — jamais le portail réel) ---
ANTAI_MOCK_TOKEN="dev-antai-mock"
# Activer le RPA Playwright réel (ANTAI_REAL=1) — nécessite ANTAI_URL/LOGIN/PASSWORD
ANTAI_REAL="0"
ANTAI_URL=""
ANTAI_LOGIN=""
ANTAI_PASSWORD=""

# --- Cron / rappels ---
# Optionnel : protège /api/cron/rappels (J10/J3/J0)
CRON_SECRET=""

# --- Preuves externes (recherche de preuves annexes) ---
# Source des "travaux" interrogée à l'analyse (Plateforme OpendataSoft, jeu de
# données "Chantiers routiers"). Défaut : Sarthe (verify works). La base doit
# être une URL OpendataSoft dont le jeu expose date_debut/date_fin + position.
# TRAVAUX_OPENDATA_BASE="https://data.sarthe.fr/api/explore/v2.1/catalog/datasets/227200029_chantiers_routiers"
# Multi-départements : liste (séparateur virgule) de bases OpendataSoft —
# chaque base est interrogée, les chantiers localisés dans plusieurs jeux ne
# sont jamais ajoutés deux fois (dédup par localisation).
# TRAVAUX_OPENDATA_BASES="https://data.sarthe.fr/api/explore/v2.1/catalog/datasets/227200029_chantiers_routiers,https://data.angers.fr/api/explore/v2.1/catalog/datasets/chantiers"

# --- Virement bancaire (RIB à afficher au paiement) ---
# ⚠️ VALEURS DE DÉMONSTRATION — à REMPLACER par le RIB définitif avant la prod.
# Tant qu'une des trois variables NEXT_PUBLIC_RIB_* est vide, l'UI affiche un
# bandeau « RIB provisoire de démonstration » (src/lib/rib.ts, RIB.placeholder).
# Laissées VIDES ici volontairement : c'est ce qui déclenche le bandeau.
RIB_IBAN=""
RIB_BIC=""
RIB_TITULAIRE=""
RIB_BANQUE=""
NEXT_PUBLIC_RIB_IBAN=""
NEXT_PUBLIC_RIB_BIC=""
NEXT_PUBLIC_RIB_TITULAIRE=""

# --- Accès de développement (opt-in explicite) ---
# 1 = autorise `/api/dev/login`, le bypass `?dev=1` / cookie `dev_login`,
# `/api/debug/env` et `/dashboard?dev=1`. Sans cette variable, ces accès sont
# refusés (403/404) même en développement. NE JAMAIS mettre à 1 en production.
ENABLE_DEV_LOGIN=""
# 1 = autorise l'écriture du magic-link dans node_modules/.cache/. Double-gate :
# ne fonctionne que si ANTAI_MOCK=1 (build E2E uniquement) — sinon refusé.
# ⚠️ Laisser VIDE sauf pour une suite E2E locale.
AUTH_DEV_FILE=""
# Relance des pieces manquantes (cron rappels, e-mail PREUVES) - demarrage
# progressif : seuls les dossiers crees a partir de cette date sont relances.
# Vide = date de mise en service (2026-10-03) ; une date ancienne (2020-01-01)
# inclut tout le portefeuille.
RAPPEL_PREUVES_DEPUIS=""
