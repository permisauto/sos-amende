{
  "crons": [
    {
      "path": "/api/cron/rappels",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/auto-alimentation",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/recuperations-decisions",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/veille-dila",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/digest-veille",
      "schedule": "0 8 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/metrics",
      "destination": "/api/metrics"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}