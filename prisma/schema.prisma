// SOS Amende — schéma conforme à la section 4 du cahier des charges

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// next-auth v5 (@auth/prisma-adapter) : modèles obligatoires — NE PAS RENOMMER
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String? // inscription inversée : mot de passe temporaire (sect. 3)
  role             Role      @default(CLIENT) // CLIENT | JURISTE | ADMIN
  credits          Int       @default(0)
  // Signature du client capturée au dépôt (cases/new) et réutilisée lors de la
  // signature de chaque dossier — le client n'a pas à retracer sa signature à
  // chaque contestation (stockage local/S3, comme les autres pièces).
  signatureUrl     String?

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  dossiers       Dossier[]
  lawyerMatches  LawyerMatch[]
  payments       Payment[]
  messages       Message[]
  messagesInternesEnvoyes MessageInterne[] @relation("MessageInterneEnvoye")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

// ---------------------------------------------------------------------------
// Tables métier — section 4 du cahier des charges
// ---------------------------------------------------------------------------

model Dossier {
  id               String        @id @default(cuid())
  userId           String
  type             DossierType   @default(AMENDE) // AMENDE | SUSPENSION
  statut           DossierStatut @default(BROUILLON)
  pvUrl            String? // avis de contravention uploadé
  pvTexte          String? @db.Text // texte brut extrait par l'OCR (détection par scan)
  extractedData    Json? // OCR : {nom, plaque, num_pv, date, heure, typeRadar, numTelePaiement, cle}
  conditions_meteo String? // résumé météo au jour de l'infraction (pluie, brouillard etc.)
  lettreGeneree    String? @db.Text // lettre remplie à partir du templateLettre (sect. 5)
  motifRejet       String? @db.Text // raison du rejet juriste (statut REJETE)
  decisionOmp      String? // décision OMP après envoi : ACCEPTE | REJETE
  decisionDetail   String? @db.Text // note du juriste sur la décision OMP
  valideLe         DateTime? // validation de la lettre par le juriste (kit envoi)
  canalEnvoi       String?   // canal d'envoi choisi par le juriste : ANTAI | TELERECOURS | LRAR
  remarquesJuriste String?   @db.Text // remarques de la vérification poussée (relance du moteur)
  dateLimite       DateTime? // délai de contestation : 45 j (amende) / 2 mois (suspension)
  travaux_présents Boolean? //TRUE si travaux connus sur la route au jour de l'infraction
  prix             Decimal       @db.Decimal(10, 2)
  failleJuridiqueId String? // faille retenue (principale) par le moteur (sect. 5)
  failleJuridique FailleJuridique? @relation(fields: [failleJuridiqueId], references: [id])
  faillesRetenues  DossierFaille[] // toutes les failles candidates (détection par scan)
  courriers        Courrier[]
  preuves          Preuve[]
  rappels          Rappel[]
  evenements       DossierEvent[]
  lawyerMatch      LawyerMatch?
  payments         Payment[]
  messages         Message[]
  messageInternes  MessageInterne[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FailleJuridique {
  id             String       @id @default(cuid())
  typeInfraction String // AMENDE | SUSPENSION
  titreFaille    String
  articleLoi     String
  regle          String?      @db.Text // règle dégagée : ce que la jurisprudence + l'article imposent
  templateLettre String       @db.Text // variables {nom}, {plaque}, {num_pv}…
  source         String?
  reglesDetection Json? // règles de détection automatique (scan PV/lettre) — voir src/lib/moteur.ts
  jurisprudence  Json? // références sourcées : [{reference, juridiction, date, url, verifiee}] (base auto-alimentée)
  statut         FailleStatut @default(ACTIVE)

  dossiers       Dossier[]
  faillesRetenues DossierFaille[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Failles identifiées automatiquement pour un dossier (détection par scan du
// PV ou de la lettre). Le juriste confirme ou rejette chaque candidat : ces
// validations alimentent la base juridique (s'auto-alimente par mises à jour).
model DossierFaille {
  id        String              @id @default(cuid())
  dossierId String
  failleId  String
  statut    DossierFailleStatut @default(CANDIDATE)

  dossier Dossier         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  faille  FailleJuridique @relation(fields: [failleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dossierId, failleId])
}

model Courrier {
  id             String  @id @default(cuid())
  dossierId      String
  pdfUrl         String?
  signatureUrl   String?
  preuveDepotUrl String?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Pièces justificatives jointes à la contestation (preuves) : téléversées par
// le client et/ou le juriste pour étayer la lettre (carte grise, récépissé de
// plainte, photos…). RGPD : supprimées avec le dossier/le compte.
model Preuve {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  userId    String? // auteur : client ou juriste
  url       String // /uploads/... (storage)
  nom       String  @default("piece")
  type      String  @default("OTHER") // CARTE_GRISE | PLAINTE | PHOTO | CERTIFICAT | AUTRE
  createdAt DateTime @default(now())

  @@index([dossierId])
}

model Rappel {
  id        String   @id @default(cuid())
  dossierId String
  type      String // J10 | J3 | J0
  sentAt    DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, type])
}

model DossierEvent {
  id        String          @id @default(cuid())
  dossierId String
  type      DossierEventType
  detail    String? // ex. URL de l'accusé, motif de rejet
  createdAt DateTime        @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, createdAt])
}

// Message échangé entre le juriste et le client sur un dossier (demande de
// complément d'information ou de preuve, réponse du client...). Le statut du
// dossier reste inchangé. `lu` = le message a été consulté par son
// destinataire (notification in-app). RGPD : supprimé avec le dossier.
model Message {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId  String
  auteur    User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  contenu   String   @db.Text
  lu        Boolean  @default(false) // lu par le destinataire (client si auteur juriste, juriste si auteur client)
  createdAt DateTime @default(now())

  @@index([dossierId, createdAt])
}

// Fil d'équipe admin ↔ juristes, ancré sur un dossier (« fil par dossier »).
// Pas de destinataire précis : chaque message est visible et répondable par
// tout membre de l'équipe (JURISTE ou ADMIN). « lu » = le fil a été ouvert
// par un membre (lu global, pas par utilisateur). Le client ne voit jamais ces
// échanges. Ne pas confondre avec Message (juriste ↔ client, par dossier).
model MessageInterne {
  id           String   @id @default(cuid())
  dossierId    String
  dossier      Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  expediteurId String
  expediteur   User     @relation("MessageInterneEnvoye", fields: [expediteurId], references: [id], onDelete: Cascade)
  contenu      String   @db.Text
  lu           Boolean  @default(false) // lu par un membre de l'équipe
  createdAt    DateTime @default(now())

  @@index([dossierId, lu])
  @@index([dossierId, createdAt])
}

model RadarCalibration {
  id             String   @id @default(cuid())
  radarId        String   @unique
  dateExpiration DateTime
  date_dernier_renouvellement DateTime? // dernière année de vérification certifiée
  etat_certificat String? // valide / expiré / défaut_de_calibrage
  preuveUrl      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Mise en relation avocat (PLAN §2 — orientation vers un avocat partenaire,
// pas de consultation juridique interne)
// ---------------------------------------------------------------------------

model LawyerMatch {
  id             String            @id @default(cuid())
  dossierId      String            @unique
  dossier        Dossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  statut         LawyerMatchStatut @default(DEMANDE)
  motif          String?           @db.Text // contexte du besoin (client)
  partnerName    String?
  partnerBarreau String?
  partnerEmail   String?
  note           String?           @db.Text // note juriste (affectation ou refus)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Paiements par virement bancaire (inscription inversée, remboursements sect. 9)
// ---------------------------------------------------------------------------

model Payment {
  id               String    @id @default(cuid())
  userId           String
  dossierId        String? // dossier concerné quand le paiement est effectué depuis le paywall du dossier
  amount           Decimal   @db.Decimal(10, 2)
  currency         String    @default("EUR")
  status           String
  kind             String    @default("AMENDE") // AMENDE | SUSPENSION
  preuveUrl        String? // /uploads/... — preuve du virement téléversée par le client
  preuveNom        String? // nom du fichier d'origine
  preuveUploadedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossier Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  JURISTE
  ADMIN
}

enum DossierType {
  AMENDE
  SUSPENSION
}

enum DossierStatut {
  BROUILLON
  EN_ANALYSE
  A_VERIFIER
  EN_ATTENTE_PAIEMENT // faille détectée mais crédit manquant — le client finalise son virement
  EN_ATTENTE_VALIDATION // lettre générée, soumise à la validation du juriste
  EN_ATTENTE_PRE_SIGNATURE // lettre validée par le juriste, en attente de la signature du client (cas B)
  PRET
  ENVOYE
  REJETE
  ERREUR_TECHNIQUE // sect. 11D
  RESOLU // libellé client : « Réponse de l'administration »
  ANNULE
}

enum FailleStatut {
  ACTIVE
  INACTIVE
  PROPOSEE // proposition issue de l'auto-alimentation (source publique) — jamais utilisée par le moteur tant que l'admin ne l'a pas validée
}

enum DossierFailleStatut {
  CANDIDATE
  CONFIRMEE
  REJETEE
}

enum LawyerMatchStatut {
  DEMANDE
  AFFECTE
  REFUSE
}

enum DossierEventType {
  CREATION
  ANALYSE
  LETTRE_GENEREE
  EN_ATTENTE
  SIGNATURE
  VALIDATION
  ENVOI
  DECISION
  REJET
  RETOUR
  PREUVE // pièce justificative ajoutée (client ou juriste)
  MESSAGE // message échangé entre le juriste et le client (fil de discussion)
  VERIFICATION_POUSSEE // relance du moteur par le juriste (remarques → nouvelle détection/lettre)
}